{
  "manifest_version": 3,
  "name": "PLaMo Web Translator",
  "version": "0.1.0",
  "minimum_chrome_version": "126",
  "description": "ローカルの PLaMo 3 Translate でウェブページを翻訳します。",
  "permissions": ["storage", "contextMenus", "offscreen", "unlimitedStorage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
